# --- App ---
APP_ENV=local
# Local-only placeholder. Production requires a random value with at least 32 characters.
# Generate one, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-secret-key-change-me
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ai_manager

# --- Redis (cache + ARQ queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
# Set QDRANT_URL=local to run embedded Qdrant without Docker; data is stored here.
QDRANT_LOCAL_PATH=.qdrant-data
QDRANT_COLLECTION=ai_manager_knowledge
QDRANT_ENABLED=false

# --- Object storage (S3-compatible / MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-manager
CONVERSATION_UPLOAD_DIR=.conversation-uploads
CUSTOMER_AVATAR_DIR=.customer-avatars
CONVERSATION_ATTACHMENT_MAX_BYTES=10485760

# --- AI providers ---
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local     # local | local-ml | openai-compatible
EMBEDDING_BASE_URL=          # example: https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=.model-cache
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_PROBE_TIMEOUT_SEC=10
OPENAI_COMPATIBLE_BASE_URL=  # example: http://localhost:20128/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=cx/gpt-5.4-mini
OPENAI_COMPATIBLE_TIMEOUT_SEC=30
OPENAI_COMPATIBLE_PROBE_TIMEOUT_SEC=10
ML_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_CHAT_RATE_LIMIT_PER_MINUTE=30
TENANT_LLM_CALLS_PER_HOUR=300
TENANT_LLM_TOKENS_PER_DAY=1000000
TENANT_LLM_COST_KOPECKS_PER_DAY=100000
YANDEX_API_KEY=
GIGACHAT_API_KEY=

# --- Channels ---
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DELIVERY_TIMEOUT_SEC=8
TELEGRAM_AUTO_REPLY_DELAY_SEC=5
# Keeps POST /channels/webhook/telegram available only for localhost tests.
# The flag is ignored outside APP_ENV=local|test; production must use a per-channel secret.
TELEGRAM_ALLOW_INSECURE_LOCAL_WEBHOOK=true
# Local embedded-Qdrant mode: run Telegram inside the API process so both paths
# share one cached vector-store client. Do not also start telegram_listener separately.
TELEGRAM_LISTENER_IN_PROCESS=false
# Telegram personal account (MTProto). Keep these only in local/production secrets.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# --- Email ---
EMAIL_FROM=Автопилот <no-reply@localhost>
EMAIL_REPLY_TO=
EMAIL_DEV_MODE=true
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_TOKEN_TTL_MIN=60
CONVERSATION_SSE_POLL_INTERVAL_SEC=1
# Unicode IDNs are accepted here. Links use IDNA/Punycode internally, while email text
# stays human-readable (production example: https://автопилот.space).
APP_PUBLIC_URL=https://автопилот.space

# --- JWT ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
