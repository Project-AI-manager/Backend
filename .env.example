# --- App ---
APP_ENV=local
# Local-only placeholder. Production requires a random value with at least 32 characters.
# Generate one, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=local-development-secret-key-change-me
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/ai_manager

# --- Redis (cache + ARQ queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ai_manager_knowledge
QDRANT_ENABLED=false

# --- Object storage (S3-compatible / MinIO local) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-manager

# --- AI providers ---
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=local     # local | yandexgpt
OPENAI_COMPATIBLE_BASE_URL=  # example: http://localhost:20128/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=cx/gpt-5.4-mini
OPENAI_COMPATIBLE_TIMEOUT_SEC=30
OPENAI_COMPATIBLE_PROBE_TIMEOUT_SEC=10
YANDEX_API_KEY=
GIGACHAT_API_KEY=

# --- Channels ---
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_DELIVERY_TIMEOUT_SEC=8
# Keeps POST /channels/webhook/telegram available only for localhost tests.
# The flag is ignored outside APP_ENV=local|test; production must use a per-channel secret.
TELEGRAM_ALLOW_INSECURE_LOCAL_WEBHOOK=true

# --- Email ---
EMAIL_FROM=Автопилот <no-reply@localhost>
EMAIL_DEV_MODE=true
EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_TOKEN_TTL_MIN=60

# --- JWT ---
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
